# Telegram (Telethon userbot)
TG_API_ID=your_api_id
TG_API_HASH=your_api_hash
TG_SESSION_NAME=alpha_listener

# Telegram Bot (for sending alerts)
TG_ALERT_BOT_TOKEN=your_bot_token
TG_ALERT_CHAT_ID=your_private_chat_id

# Anthropic
ANTHROPIC_API_KEY=your_key

# Twitter/X (Phase 3)
X_BEARER_TOKEN=your_token

# Birdeye (Phase 2)
BIRDEYE_API_KEY=your_key

# Redis
REDIS_URL=redis://localhost:6379

# Database
DB_PATH=signals.db
CACHE_TTL_SECONDS=300

# Chain preference for ticker resolution. Comma-separated DexScreener chainId
# values. A ticker like $GME exists on many chains; without this it resolves to
# whichever chain has the deepest liquidity, which may not be the one you trade.
# Leave empty to keep the old highest-liquidity-wins behavior.
# Example: PREFERRED_CHAINS=robinhood,solana
PREFERRED_CHAINS=

# ---- Trading / autonomous buy agent ----
# SAFE BY DEFAULT. Nothing below places a real order unless you explicitly opt in.
# Master mode: paper (default, simulates fills) or live. Live ALSO needs TRADING_ENABLED=true.
TRADING_MODE=paper
# Autonomy: approval (default — you confirm each buy in Telegram) or auto.
TRADING_AUTONOMY=approval
# Your Telegram USER id (numeric). Required so ONLY you can tap Confirm on a buy
# proposal — without it, approval falls back to owner-DM-only. Get it from @userinfobot.
TRADING_OWNER_USER_ID=
# Kill switches (default off). Live buys require TRADING_ENABLED=true;
# fully-autonomous LIVE buys additionally require TRADING_ALLOW_AUTO=true.
TRADING_ENABLED=false
TRADING_ALLOW_AUTO=false
# Solana wallet secret (base58) — ONLY needed for live mode. Use a DEDICATED hot
# wallet funded to at most your deployed-capital limit, never your main wallet.
TRADER_WALLET_SECRET=
# Solana RPC endpoint (a paid one — Helius/Triton/QuickNode — is strongly
# recommended for reliable live sends and safety reads).
SOLANA_RPC_URL=
# Paper-mode only: reference SOL/USD price used to simulate fills.
SOL_USD_PRICE=150
