# Twitter/X (Phase 3)
X_BEARER_TOKEN=your_token

# Birdeye (Phase 2)
BIRDEYE_API_KEY=your_key

# Redis
REDIS_URL=redis://localhost:6379

# Database
DATABASE_URL=sqlite:///signals.db
